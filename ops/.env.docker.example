# Template for ops/.env.docker (copy it, then fill in the secrets).
# Local docker-compose environment — sandbox/dev only. Do not point this
# compose file at production infrastructure.
#
# NODE_ENV=production so local behaviour matches the hosted box (secure
# cookies, https-only webhook URLs). If cookies don't stick on plain http
# localhost, that's why. — MK
NODE_ENV=production
PORT=3000

# Acquirer callback signing secret (HMAC key the acquirer signs callbacks
# with). Never commit a real value: copy this file to ops/.env.docker, which
# is gitignored, and fill it in. For local use generate one with
#   openssl rand -hex 32
# The value that used to be committed here is public in git history and must
# be treated as burned (rotated with the acquirer), not reused.
ACQUIRER_CALLBACK_SIGNING_SECRET=

# Login codes (OTP). No email or SMS delivery is wired up, and with
# NODE_ENV=production the code is neither shown nor logged, so nobody can
# finish signing in. For a hosted demo, show it on the login page:
#   OTP_DEV_EXPOSE=true
# and replace the seeded passwords (they are public in the repo) with
# scripts/set_passwords.ts; see ops/README.md.
